				var getShareModeStringFromModeEnum = function (mode) {
					switch (mode) {
						case 2:
							return "copy";
						case 3:
							return "atMention";
						case 4:
							return "linkSettings";
						case 5:
							return "manageAccess";
						case 6:
							return "notify";
						case 7:
							return "addPeople";
						case 8:
							return "RMA";
						default:
							return "share";
